# Resend (https://resend.com) API key used by src/lib/api/contact.functions.ts
# to email contact-form submissions to gairystudio@gmail.com.
# 1. Sign up free at https://resend.com and create an API key.
# 2. Copy this file to `.env` (gitignored) and put the REAL key there for
#    local dev, and set RESEND_API_KEY in your Vercel project's
#    Environment Variables for production. NEVER commit a real key here —
#    this file is an example/template only and IS committed to git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
